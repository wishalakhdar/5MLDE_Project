# Copier en .env (jamais versionné) puis adapter. Valeurs de démonstration LOCALE uniquement.

# --- Services (infra/compose.yml) ---
MLFLOW_PORT=7281
PREFECT_PORT=4200
GRAFANA_PORT=3000
POSTGRES_PORT=5432

POSTGRES_PASSWORD=change-me-admin
API_DB_PASSWORD=change-me-api
GRAFANA_DB_PASSWORD=change-me-grafana
GRAFANA_ADMIN_PASSWORD=change-me-grafana-admin

# --- Variables à exporter dans chaque terminal qui lance du code Python ---
# (un fichier .env n'est PAS lu automatiquement par le shell)
MLFLOW_TRACKING_URI=http://localhost:7281
MLFLOW_REGISTRY_URI=http://localhost:7281
PREFECT_API_URL=http://localhost:4200/api

# --- Alerte en cas d'échec (laisser vide = alerte seulement dans les logs) ---
ALERT_WEBHOOK_URL=
