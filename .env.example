# Copier en .env (jamais versionne) puis adapter. Valeurs de demonstration LOCALE uniquement.
# Les noms ci-dessous sont ceux utilises par infra/compose.yml.

POSTGRES_PORT=5432

POSTGRES_ADMIN_PASSWORD=change-me-admin
API_WRITER_PASSWORD=change-me-api
GRAFANA_READER_PASSWORD=change-me-lecture
PIPELINE_WRITER_PASSWORD=change-me-pipeline
GRAFANA_ADMIN_PASSWORD=change-me-grafana

# Variables a definir dans chaque terminal qui lance du code Python
# (un fichier .env n'est PAS lu automatiquement par le shell).
# Les valeurs par defaut du projet suffisent en local.
MLFLOW_TRACKING_URI=http://localhost:7281
PREFECT_API_URL=http://localhost:4200/api

# Alerte en cas d'echec (laisser vide = alerte seulement dans les logs)
ALERT_WEBHOOK_URL=
